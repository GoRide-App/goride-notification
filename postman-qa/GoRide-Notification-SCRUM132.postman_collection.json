{
  "info": {
    "_postman_id": "41b5ebdc-c376-4255-8fcf-ed8bb16f9f62",
    "name": "GoRide Notification — Trip Notification Triggers (QA-test branch)",
    "description": "Regression pack for goride-notification, QA-test branch. Covers /health, /api/notifications/device-token, and all five /api/notifications/trip/* triggers: driver-arrived (SCRUM-128), completed (SCRUM-129), payment-confirmed (SCRUM-132), and the two driver-facing endpoints added under SCRUM-130 — driver/ride-request and driver/booking-change. No auth header is required; none of these controllers carry an [Authorize] attribute. Import this file plus set the baseUrl/riderId/tripId/driverId variables, then Run collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 Health",
      "item": [
        {
          "name": "GET /health — service and DB are up",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
