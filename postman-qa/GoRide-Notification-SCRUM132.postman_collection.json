    {
      "name": "Trip Notifications — Driver (SCRUM-130)",
      "item": [
        {
          "name": "Driver ride request — happy path",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
                  "const body = pm.response.json();",
                  "pm.test('status is RIDE_REQUESTED', () => pm.expect(body.status).to.eql('RIDE_REQUESTED'));",
                  "pm.test('driverId echoed back matches request', () => pm.expect(body.driverId).to.eql(pm.collectionVariables.get('driverId')));",
                  "pm.test('channels includes push and email', () => {",
                  "  pm.expect(body.channels).to.include('push');",
                  "  pm.expect(body.channels).to.include('email');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tripId\": \"{{tripId}}\",\n  \"driverId\": \"{{driverId}}\",\n  \"riderId\": \"{{riderId}}\",\n  \"pickupLocation\": \"Colombo Fort Railway Station\",\n  \"dropoffLocation\": \"Bambalapitiya\",\n  \"fare\": 480.00\n}",
              "options": { "raw": { "language": "json" } }
